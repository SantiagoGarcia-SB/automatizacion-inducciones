        <!-- ===================== TITULO Y STACK ===================== -->
        <mxCell id="title" value="TO-BE — Flujo completo de radicación, análisis automático y resultados por lote" style="text;html=1;align=center;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="-140" width="2000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="stack" value="STACK TO-BE: Angular · Python · PostgreSQL · Cloud Storage · Firebase Auth (Identity Platform) · AI Gateway (Gemini) · GSA dedicada (infra GCP — a confirmar). Lectura: izquierda→derecha = camino automático. La rama inferior es el fallback manual, que se reincorpora antes del cierre de lote." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#B3B3B3;arcSize=6;fontSize=11;fontStyle=2;fontColor=#555555;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="-95" width="2600" height="40" as="geometry" />
        </mxCell>

        <!-- ===================== FASE 1 — CAMINO PRINCIPAL ===================== -->
        <mxCell id="F1a" value="&lt;b style=&quot;font-size:10px;opacity:0.65&quot;&gt;COMERCIAL&lt;/b&gt;&lt;br&gt;Entra a la app (Angular)&lt;br&gt;Login Firebase Auth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;arcSize=15;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="180" height="110" as="geometry" />
        </mxCell>
        <mxCell id="F1b" value="&lt;b style=&quot;font-size:10px;opacity:0.65&quot;&gt;COMERCIAL&lt;/b&gt;&lt;br&gt;Sube Excel + paz y salvo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;arcSize=15;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="250" y="250" width="180" height="110" as="geometry" />
        </mxCell>
        <mxCell id="F1c" value="&lt;b style=&quot;font-size:10px;opacity:0.65&quot;&gt;SISTEMA&lt;/b&gt;&lt;br&gt;Audita: heurística + IA Destino&lt;br&gt;(AI Gateway / Gemini)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=15;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="250" width="190" height="110" as="geometry" />
        </mxCell>
        <mxCell id="D1" value="¿Archivo&lt;br&gt;válido?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;strokeWidth=3;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="680" y="210" width="150" height="190" as="geometry" />
        </mxCell>
        <mxCell id="F1d" value="&lt;b style=&quot;font-size:10px;opacity:0.65&quot;&gt;SISTEMA&lt;/b&gt;&lt;br&gt;Persiste en PostgreSQL&lt;br&gt;+ Cloud Storage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=15;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="860" y="250" width="190" height="110" as="geometry" />
        </mxCell>

        <!-- ===================== FASE 2 — CONSULTA AUTOMÁTICA (cluster paralelo) ===================== -->
        <mxCell id="F2a" value="Cliente 360&lt;br&gt;ingresos + score&lt;br&gt;(solo clientes Bolívar)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCF2F4;strokeColor=#17A2B8;arcSize=15;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1080" y="40" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="F2b" value="Siniestros con El Libertador&lt;br&gt;(acumulado histórico)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCF2F4;strokeColor=#17A2B8;arcSize=15;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1080" y="150" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="F2c" value="Modelo de analítica (TI)&lt;br&gt;doc+ingresos+score+ocupación='Independiente'&lt;br&gt;+núm.solicitud[bloqueado TI]. Reintenta 2x" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCF2F4;strokeColor=#17A2B8;arcSize=15;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1080" y="260" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="F2d" value="Tablas SAI (GCP): doc+estado=ASEGURADA&lt;br&gt;cotejo IA de dirección — solo INQ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCF2F4;strokeColor=#17A2B8;arcSize=15;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1080" y="370" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="D2" value="¿Camino&lt;br&gt;automático?&lt;br&gt;&lt;span style=&quot;font-size:9px;font-weight:normal&quot;&gt;(360+modelo OK,&lt;br&gt;ningún solicitante&lt;br&gt;es empresa)&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;strokeWidth=3;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1340" y="150" width="170" height="220" as="geometry" />
        </mxCell>
        <mxCell id="F2note" value="Cae a FALLBACK (toda la solicitud) si, para cualquier solicitante (INQ o algún COA):&lt;br&gt;• no está en Cliente 360&lt;br&gt;• es persona jurídica (empresa) → Informe Express&lt;br&gt;• el modelo falla tras 2 reintentos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;arcSize=8;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="420" height="110" as="geometry" />
        </mxCell>

        <!-- ===================== REGLAS DURAS + RESULTADO ===================== -->
        <mxCell id="F2b1" value="Regla dura 1&lt;br&gt;Siniestros acum. ≥ umbral&lt;br&gt;parametrizable → NIEGA&lt;br&gt;(por participante) — ACTIVA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6E6;strokeColor=#B85450;arcSize=15;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1560" y="60" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="F2b3" value="Regla dura 3&lt;br&gt;Dirección ya ASEGURADA&lt;br&gt;en SAI (cotejo IA) → NIEGA&lt;br&gt;solo INQ — ACTIVA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6E6;strokeColor=#B85450;arcSize=15;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1560" y="180" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="F2b2" value="Regla dura 2&lt;br&gt;Moras DataCrédito ≥ $1.000.000&lt;br&gt;→ NIEGA — INACTIVA&lt;br&gt;(pendiente Ger. Técnica + VP Patrimonial)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontColor=#666666;arcSize=15;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1560" y="300" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="F2b4" value="Combinar resultado&lt;br&gt;INQ + COAs → resultado&lt;br&gt;final de la solicitud&lt;br&gt;— TBD, pendiente definición mayor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontColor=#666666;arcSize=15;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1820" y="180" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="F2b5" value="&lt;b style=&quot;font-size:10px;opacity:0.65&quot;&gt;SISTEMA&lt;/b&gt;&lt;br&gt;Guarda resultado en Postgres&lt;br&gt;marca 'consultada'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=15;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2070" y="180" width="190" height="110" as="geometry" />
        </mxCell>

        <!-- ===================== FASE 4 — CIERRE DE LOTE ===================== -->
        <mxCell id="D4" value="¿Alguna solicitud&lt;br&gt;del lote cayó&lt;br&gt;en fallback?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;strokeWidth=3;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="2310" y="140" width="170" height="190" as="geometry" />
        </mxCell>
        <mxCell id="F4msg" value="Pantalla al comercial:&lt;br&gt;'requiere revisión manual,&lt;br&gt;info en próximas horas'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;arcSize=15;fontSize=10;" vertex="1" parent="1">
