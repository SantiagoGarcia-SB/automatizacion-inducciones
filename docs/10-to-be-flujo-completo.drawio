        <!-- ===================== RAMA FALLBACK (por debajo) ===================== -->
        <mxCell id="F3a" value="&lt;b style=&quot;font-size:10px;opacity:0.65&quot;&gt;AUXILIAR&lt;/b&gt;&lt;br&gt;Radica la solicitud en SAI&lt;br&gt;(Tablero Sección 1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=15;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1760" y="560" width="190" height="110" as="geometry" />
