  <diagram name="TO-BE - Flujo completo de inducciones (horizontal)" id="to-be-flujo-completo-h">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4850" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
