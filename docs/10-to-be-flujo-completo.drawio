<mxfile host="app.diagrams.net" modified="2026-09-01T00:00:00.000Z" agent="Claude Code" version="24.0.0" type="device">
  <diagram name="TO-BE - Flujo completo de inducciones (horizontal)" id="to-be-flujo-completo-h">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="5000" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===================== TITULO ===================== -->
        <mxCell id="title" value="TO-BE — Flujo completo de radicación, análisis automático y resultados por lote" style="text;html=1;align=center;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="-140" width="2000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="stack" value="Lectura: izquierda→derecha = camino automático. La rama inferior es el fallback manual, que se reincorpora antes del cierre de lote." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#B3B3B3;arcSize=6;fontSize=11;fontStyle=2;fontColor=#555555;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="-95" width="2600" height="40" as="geometry" />
        </mxCell>

        <!-- ===================== FASE 1 — CAMINO PRINCIPAL ===================== -->
        <mxCell id="F1a" value="&lt;b style=&quot;font-size:10px;opacity:0.65&quot;&gt;COMERCIAL&lt;/b&gt;&lt;br&gt;Entra a la app&lt;br&gt;Inicia sesión" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;arcSize=15;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="180" height="110" as="geometry" />
        </mxCell>
        <mxCell id="F1b" value="&lt;b style=&quot;font-size:10px;opacity:0.65&quot;&gt;COMERCIAL&lt;/b&gt;&lt;br&gt;Sube Excel + paz y salvo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;arcSize=15;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="250" y="250" width="180" height="110" as="geometry" />
        </mxCell>
        <mxCell id="F1c" value="&lt;b style=&quot;font-size:10px;opacity:0.65&quot;&gt;SISTEMA&lt;/b&gt;&lt;br&gt;Audita: heurística +&lt;br&gt;validación de Destino con IA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=15;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="250" width="190" height="110" as="geometry" />
        </mxCell>
        <mxCell id="D1" value="¿Archivo&lt;br&gt;válido?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;strokeWidth=3;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="680" y="210" width="150" height="190" as="geometry" />
        </mxCell>
        <mxCell id="F1d" value="&lt;b style=&quot;font-size:10px;opacity:0.65&quot;&gt;SISTEMA&lt;/b&gt;&lt;br&gt;Guarda la solicitud" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=15;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="860" y="250" width="190" height="110" as="geometry" />
        </mxCell>

        <!-- ===================== FASE 2 — MOTOR + MODELO DE ANALÍTICA (secuencial) ===================== -->
        <mxCell id="MOTOR_LABEL" value="MOTOR (nuevo motor de inducciones) — corre sobre cada solicitante" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#17A2B8;" vertex="1" parent="1">
          <mxGeometry x="1090" y="130" width="330" height="20" as="geometry" />
        </mxCell>
        <mxCell id="MOTOR_DURAS" value="&lt;b style=&quot;font-size:10px&quot;&gt;Reglas duras — niegan directo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;(priman sobre el Modelo y sobre el Lote)&lt;/span&gt;&lt;br&gt;• Inmueble asegurado y vigente a nombre de solicitantes&lt;br&gt;• Anteriores negadas por deudores de profesión (Marca)&lt;br&gt;• Cliente restringido&lt;br&gt;• Uso no asegurable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;arcSize=12;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1090" y="155" width="330" height="170" as="geometry" />
        </mxCell>
        <mxCell id="MOTOR_MARCAS" value="&lt;b style=&quot;font-size:10px&quot;&gt;Marcas — no niegan aquí&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;(pasan al Modelo de lote, Fase 4)&lt;/span&gt;&lt;br&gt;• Siniestros con El Libertador&lt;br&gt;• Preselecta → moras" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;arcSize=12;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1090" y="335" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="MODELO" value="&lt;b style=&quot;font-size:10px;opacity:0.65&quot;&gt;SISTEMA&lt;/b&gt;&lt;br&gt;&lt;b&gt;Modelo de analítica&lt;/b&gt;&lt;br&gt;Variables: ingresos, acierta,&lt;br&gt;ocupación (siempre 'Independiente')&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#B85450&quot;&gt;Pendiente: núm. de solicitud&lt;br&gt;(bloqueado TI, sin confirmar)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCF2F4;strokeColor=#17A2B8;arcSize=12;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1470" y="225" width="230" height="170" as="geometry" />
        </mxCell>
        <mxCell id="D2" value="¿Camino&lt;br&gt;automático?&lt;br&gt;&lt;span style=&quot;font-size:9px;font-weight:normal&quot;&gt;(Motor + Modelo&lt;br&gt;resolvieron todo,&lt;br&gt;sin fallback)&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;strokeWidth=3;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1760" y="210" width="170" height="190" as="geometry" />
        </mxCell>
        <mxCell id="F2note" value="Cae a FALLBACK si, para cualquier solicitante, el Motor o el Modelo de analítica no logran resolver automáticamente (dato faltante, caso no cubierto, error tras reintentos)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;arcSize=8;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="420" height="110" as="geometry" />
        </mxCell>

        <!-- ===================== RESULTADO DE LA SOLICITUD ===================== -->
        <mxCell id="F2b4" value="Combinar resultado de la solicitud&lt;br&gt;• Regla dura activa → NEGADA (prima)&lt;br&gt;• Si no → resultado del Modelo&lt;br&gt;INQ+COAs: TBD, pendiente definición" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontColor=#666666;arcSize=15;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1980" y="240" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="F2b5" value="&lt;b style=&quot;font-size:10px;opacity:0.65&quot;&gt;SISTEMA&lt;/b&gt;&lt;br&gt;Guarda resultado&lt;br&gt;marca 'consultada'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=15;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2230" y="250" width="190" height="110" as="geometry" />
        </mxCell>

        <!-- ===================== FASE 4 — CIERRE DE LOTE ===================== -->
        <mxCell id="D4" value="¿Alguna solicitud&lt;br&gt;del lote cayó&lt;br&gt;en fallback?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;strokeWidth=3;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="2470" y="210" width="170" height="190" as="geometry" />
        </mxCell>
        <mxCell id="F4msg" value="Pantalla al comercial:&lt;br&gt;'requiere revisión manual,&lt;br&gt;info en próximas horas'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;arcSize=15;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2470" y="440" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="F4note" value="TBD (Operación): ¿el Analista puede radicar aprobadas mientras otras del mismo lote siguen en fallback?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontColor=#666666;arcSize=8;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="510" y="560" width="380" height="110" as="geometry" />
        </mxCell>
        <mxCell id="F4c" value="&lt;b style=&quot;font-size:10px;opacity:0.65&quot;&gt;SISTEMA&lt;/b&gt;&lt;br&gt;Modelo de lote — usa marcas&lt;br&gt;acumuladas (siniestros, moras)&lt;br&gt;→ decide aprobado/rechazado del lote" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;arcSize=15;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2730" y="240" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="F4d" value="Pantalla al comercial:&lt;br&gt;'n aprobadas / n negadas —&lt;br&gt;PDF llega en minutos'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=15;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="2990" y="250" width="210" height="110" as="geometry" />
        </mxCell>

        <!-- ===================== FASE 5 — TABLERO ===================== -->
        <mxCell id="F5b" value="Tablero Sección 2 — Radicación y emisión (aprobadas)&lt;br&gt;ANALISTA radica+aprueba en SAI&lt;br&gt;texto prellenado: TBD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;arcSize=15;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="3250" y="250" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="F5d" value="Negadas automáticas&lt;br&gt;batch nocturno → directo a&lt;br&gt;SAI, sin humano" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;arcSize=15;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="3250" y="410" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="F5e" value="Lote 100% radicado en SAI&lt;br&gt;(aprobadas emitidas + negadas&lt;br&gt;en batch + fallback ya emitido)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=15;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="3510" y="250" width="210" height="110" as="geometry" />
        </mxCell>

        <!-- ===================== FASE 6 — RESULTADOS ===================== -->
        <mxCell id="F6a" value="&lt;b style=&quot;font-size:10px;opacity:0.65&quot;&gt;SISTEMA&lt;/b&gt;&lt;br&gt;Genera PDF comercial&lt;br&gt;+ PDF inmobiliaria" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=15;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="3770" y="250" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="F6b" value="&lt;b style=&quot;font-size:10px;opacity:0.65&quot;&gt;SISTEMA&lt;/b&gt;&lt;br&gt;Envía correo con PDFs&lt;br&gt;CC director/backup, BCC auditoría" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=15;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="4000" y="250" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="F6c" value="&lt;b style=&quot;font-size:10px;opacity:0.65&quot;&gt;SISTEMA&lt;/b&gt;&lt;br&gt;Registra en histórico&lt;br&gt;de envíos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=15;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="4240" y="250" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="F6d" value="Lanza Ley 2300 por lote&lt;br&gt;reemplaza batch quincenal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=15;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="4470" y="250" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="END" value="El ejecutivo comercial&lt;br&gt;recibe los resultados del lote" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=40;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="4710" y="240" width="240" height="120" as="geometry" />
