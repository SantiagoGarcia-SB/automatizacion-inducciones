        <mxCell id="F3c" value="&lt;b style=&quot;font-size:10px;opacity:0.65&quot;&gt;ANALISTA (si empresa)&lt;/b&gt;&lt;br&gt;Consigue Informe Express&lt;br&gt;DataCrédito" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;arcSize=15;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2000" y="710" width="190" height="110" as="geometry" />
        </mxCell>
        <mxCell id="F3d" value="Se consulta el mismo Motor&lt;br&gt;+ Modelo de analítica, con los&lt;br&gt;datos reunidos a mano" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCF2F4;strokeColor=#17A2B8;arcSize=15;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2270" y="560" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="F3e" value="&lt;b style=&quot;font-size:10px;opacity:0.65&quot;&gt;ANALISTA&lt;/b&gt;&lt;br&gt;Emite resultado en SAI&lt;br&gt;(ya estaba radicada)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;arcSize=15;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2510" y="560" width="190" height="110" as="geometry" />
        </mxCell>

        <!-- ===================== LEYENDA ===================== -->
        <mxCell id="legend" value="Colores: naranja=Comercial · verde=Sistema (automático) · azul=Auxiliar / hito · morado=Orquestación de lote / Marca hacia el Lote · amarillo=Analista · celeste=Endpoint externo / Modelo · rojo=negado / regla dura · gris punteado=TBD o bloqueado · diamante=decisión" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
