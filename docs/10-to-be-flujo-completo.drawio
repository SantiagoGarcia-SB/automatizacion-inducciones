        <mxCell id="F3b" value="&lt;b style=&quot;font-size:10px;opacity:0.65&quot;&gt;ANALISTA&lt;/b&gt;&lt;br&gt;Busca a mano las variables&lt;br&gt;que pide el Motor: marca, siniestros,&lt;br&gt;preselecta, restricciones, uso, inmueble&lt;br&gt;(Tablero Sección 3 — Análisis)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;arcSize=15;fontSize=10;" vertex="1" parent="1">
